{
    "name": "adminflow/adminflow",
    "type": "project",
    "description": "AdminFlow - Next-gen modular admin foundation and plugin framework.",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^11.0 || ^12.0 || ^13.0",
        "laravel/tinker": "^2.9",
        "adminflow/core": "@dev",
        "adminflow/cms": "@dev"
    },
    "require-dev": {
        "carthage-software/mago": "^1.59",
        "fakerphp/faker": "^1.23",
        "laravel/sail": "^1.30",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "AdminFlow\\Host\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "mago": "./vendor/bin/mago fmt && ./vendor/bin/mago lint",
        "mago:fmt": "./vendor/bin/mago fmt",
        "mago:lint": "./vendor/bin/mago lint",
        "mago:fix": "./vendor/bin/mago lint --fix --format-after-fix",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
