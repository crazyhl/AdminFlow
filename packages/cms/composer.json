{
    "name": "adminflow/cms",
    "description": "AdminFlow CMS Plugin (Markdown Posts, Media Library, Comments, Hugo Import)",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "M1racle",
            "email": "crazyhl@163.com"
        }
    ],
    "require": {
        "php": "^8.4 || ^8.5",
        "adminflow/core": "@dev",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "AdminFlow\\CMS\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AdminFlow\\CMS\\Providers\\CmsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
